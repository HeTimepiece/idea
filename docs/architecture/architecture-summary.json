{
  "system": "web3-x-matrix",
  "version": "v1",
  "phase": "phase-1",
  "stack": {
    "runtime": "nodejs-22",
    "language": "typescript-5.6+",
    "backend": "nestjs-11",
    "frontend": "nextjs-15",
    "database": "postgresql-16",
    "queue": "bullmq-5",
    "cache": "redis-7",
    "scraping": "playwright-1.54+",
    "llm": "openai-responses-api"
  },
  "services": [
    "api-admin",
    "web-admin",
    "worker-pipeline",
    "publisher-x",
    "llm-gateway",
    "risk-engine"
  ],
  "phase1_sources": [
    "rss-news",
    "structured-public-api",
    "curated-x-signals",
    "market-metadata"
  ],
  "core_pipeline": [
    "ingestion",
    "topic-selection",
    "briefing",
    "generation",
    "de-ai-rewrite",
    "review",
    "publish",
    "performance-sync"
  ],
  "primary_entities": [
    "sources",
    "source_items",
    "topic_candidates",
    "accounts",
    "account_personas",
    "content_jobs",
    "content_variants",
    "review_decisions",
    "publish_events",
    "account_risk_events"
  ],
  "risk_controls": [
    "daily-quota",
    "min-post-interval",
    "manual-approval-mode",
    "topic-keyword-blacklist",
    "global-kill-switch",
    "account-cooldown"
  ],
  "implementation_priority": [
    "bootstrap-monorepo",
    "schema-migrations",
    "source-ingestion",
    "topic-selection",
    "content-pipeline",
    "review-queue",
    "x-publisher"
  ]
